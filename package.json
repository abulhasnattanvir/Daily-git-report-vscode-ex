{
    "name": "daily-git-report",
    "displayName": "Daily Git Report",
    "description": "Shows daily Git commits report per contributor in VS Code",
    "version": "0.1.0",
    "publisher": "your-github-username",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other",
        "SCM Providers"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "dailyGitReport.showReport",
                "title": "Daily Git Report: Show Today's Commits",
                "category": "Git",
                "icon": "$(git-commit)"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.100.0",
        "@types/node": "^20.18.0",
        "typescript": "^5.7.3",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.1.0"
    },
    "dependencies": {
        "simple-git": "^3.27.0"
    },
    "keywords": [
        "git",
        "commit",
        "report",
        "daily",
        "contributor"
    ],
    "author": "Abul Hasnat",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-github-username/daily-git-report.git"
    }
}